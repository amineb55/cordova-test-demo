# OBLIGATOIRE — Gemini : compréhension vidéo native + génération
# Clé à créer sur https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optionnelle — Whisper : transcript avec timestamps précis.
# Si absente, le transcript vient de Gemini (étage 3).
OPENAI_API_KEY=

# Optionnel — remplacer les modèles par défaut (vérifiés août 2026).
# GEMINI_MODELE_VIDEO=gemini-3.6-flash
# GEMINI_MODELE_TEXTE=gemini-3.6-flash

# Optionnel — plafond de réflexion (thinking budget) par appel Gemini,
# en tokens, facturés au tarif de sortie et inclus dans l'estimation de
# coût affichée. -1 = automatique (le modèle décide), 0 = désactivée,
# défaut : 2048.
# GEMINI_THINKING_BUDGET=2048
